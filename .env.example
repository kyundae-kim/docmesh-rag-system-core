# docmesh-rag-system-core environment example
#
# Replace placeholders with real deployment values. Never commit real secrets.
# The library reads the process environment; it does not load this file itself.
#
# Documentation:
# - docs/api.md: every public export and method contract
# - docs/examples.md: public-only usage flows
# - docs/config.md: variables, defaults, precedence, and lifecycle
#
# bootstrap_rag_core_from_env() also requires non-env function arguments:
# - metadata_path: RAG metadata SQLite path (different from DMS_SQLITE_PATH)
# - optional chunk_size/chunk_overlap and startup health-check flags

# -----------------------------------------------------------------------------
# RAG common runtime (docmesh-py-core v0.5.0)
# -----------------------------------------------------------------------------
DOCMESH_ENV=development
# DOCMESH_SECURITY_MODE=development
# DOCMESH_PRODUCTION_ALIASES=prod,production

# -----------------------------------------------------------------------------
# Ollama: required by the standard RAG bootstrap
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_GENERATION_MODEL=gpt-oss:20b
OLLAMA_VERIFY_SSL=true
OLLAMA_FOLLOW_REDIRECTS=true
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Milvus/Milvus Lite: required by the standard RAG bootstrap
# -----------------------------------------------------------------------------
MILVUS_URI=./data/rag-vectors.db
# MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=rag_chunks
MILVUS_SECURE=false
MILVUS_CONNECT_TIMEOUT_SECONDS=10
MILVUS_REQUEST_TIMEOUT_SECONDS=30
MILVUS_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# DMS common and metadata backend selection (dms-core v0.6.0)
# -----------------------------------------------------------------------------
# DMS settings use a separate namespace so they cannot consume the RAG service
# settings above. DMS_METADATA_BACKEND explicitly selects one metadata backend.
DMS_DOCMESH_ENV=development
# DMS_DOCMESH_SECURITY_MODE=development
# DMS_DOCMESH_PRODUCTION_ALIASES=prod,production
DMS_METADATA_BACKEND=sqlite
DMS_CONFIGURATION_STRICT=false

# -----------------------------------------------------------------------------
# DMS metadata: SQLite option (active local-development selection)
# -----------------------------------------------------------------------------
DMS_SQLITE_PATH=./data/dms.db
DMS_SQLITE_READONLY=false
DMS_SQLITE_ENABLE_WAL=true
DMS_SQLITE_BUSY_TIMEOUT_MS=5000
DMS_SQLITE_CHECK_SAME_THREAD=false
DMS_SQLITE_ECHO=false

# -----------------------------------------------------------------------------
# DMS metadata: PostgreSQL option
# -----------------------------------------------------------------------------
# To use PostgreSQL, set DMS_METADATA_BACKEND=postgresql, configure every
# required value below, and remove/comment the DMS_SQLITE_* selection.
# DMS_POSTGRES_HOST=postgres.example.com
# DMS_POSTGRES_PORT=5432
# DMS_POSTGRES_DB=dms
# DMS_POSTGRES_USER=dms
# DMS_POSTGRES_PASSWORD=replace-me
# DMS_POSTGRES_SSLMODE=prefer
# DMS_POSTGRES_CONNECT_TIMEOUT_SECONDS=10
# DMS_POSTGRES_POOL_SIZE=5
# DMS_POSTGRES_MAX_OVERFLOW=10
# DMS_POSTGRES_POOL_PRE_PING=false
# DMS_POSTGRES_POOL_RECYCLE_SECONDS=-1
# DMS_POSTGRES_ECHO=false
# DMS_POSTGRES_APPLICATION_NAME=docmesh-rag-system-core
# DMS_POSTGRES_DSN is not supported.

# -----------------------------------------------------------------------------
# DMS object storage: always required, including with SQLite metadata
# -----------------------------------------------------------------------------
DMS_MINIO_ENDPOINT=minio:9000
DMS_MINIO_ACCESS_KEY=replace-me
DMS_MINIO_SECRET_KEY=replace-me
DMS_MINIO_BUCKET=documents
DMS_MINIO_SECURE=false
DMS_MINIO_CERT_CHECK=false
# DMS_MINIO_REGION=
DMS_MINIO_REQUEST_TIMEOUT_SECONDS=30
DMS_MINIO_MAX_RETRIES=3

# Production requirements:
# - DOCMESH_SECURITY_MODE=production: OLLAMA_VERIFY_SSL=true, MILVUS_SECURE=true
# - DMS_DOCMESH_SECURITY_MODE=production:
#   DMS_MINIO_SECURE=true and DMS_MINIO_CERT_CHECK=true
#
# Unsupported legacy patterns:
# - OLLAMA_EMBED__*
# - OLLAMA_GENERATE__*
# - MILVUS__*
# - DMS_POSTGRES_DSN
