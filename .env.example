# docmesh-rag-system-core canonical configuration example
# Configuration is loaded through docmesh-py-core v0.2.0.

# Shared DocMesh runtime
DOCMESH_ENV=development
DOCMESH_HEALTHCHECK_ENABLED=true

# Shared Ollama runtime
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_GENERATION_MODEL=gpt-oss:20b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

# Milvus runtime
MILVUS_URI=./data/metadata.milvus.db
MILVUS_DB_NAME=default
MILVUS_COLLECTION=rag_chunks
MILVUS_SECURE=false
MILVUS_CONNECT_TIMEOUT_SECONDS=10
MILVUS_REQUEST_TIMEOUT_SECONDS=30
MILVUS_MAX_RETRIES=3

# Optional when the Milvus server requires authentication.
# MILVUS_TOKEN=

# Legacy envs are not supported:
# - OLLAMA_EMBED__*
# - OLLAMA_GENERATE__*
# - MILVUS__*
