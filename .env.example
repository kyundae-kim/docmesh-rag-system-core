# docmesh-rag-system-core canonical configuration example
# Configuration is loaded through docmesh-py-core v0.5.0 and dms-core v0.6.0.

# RAG DocMesh runtime
DOCMESH_ENV=development

# Shared Ollama runtime
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_GENERATION_MODEL=gpt-oss:20b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

# Milvus runtime
MILVUS_URI=./data/metadata.milvus.db
MILVUS_DB_NAME=default
MILVUS_COLLECTION=rag_chunks
MILVUS_SECURE=false
MILVUS_CONNECT_TIMEOUT_SECONDS=10
MILVUS_REQUEST_TIMEOUT_SECONDS=30
MILVUS_MAX_RETRIES=3


# Optional when the Milvus server requires authentication.
# MILVUS_TOKEN=

# DMS runtime and metadata backend (local development)
DMS_DOCMESH_ENV=development
DMS_METADATA_BACKEND=sqlite
DMS_SQLITE_PATH=./data/dms.db
DMS_SQLITE_ENABLE_WAL=true

# DMS object storage (replace placeholders with a reachable MinIO service)
DMS_MINIO_ENDPOINT=minio:9000
DMS_MINIO_ACCESS_KEY=replace-me
DMS_MINIO_SECRET_KEY=replace-me
DMS_MINIO_BUCKET=documents
DMS_MINIO_SECURE=false
# Production also requires DMS_MINIO_CERT_CHECK=true.

# Legacy envs are not supported:
# - OLLAMA_EMBED__*
# - OLLAMA_GENERATE__*
# - MILVUS__*
