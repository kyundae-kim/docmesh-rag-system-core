# docmesh-rag-system-core example environment
#
# You can use either:
# 1) docmesh-py-core style variables for shared service settings, or
# 2) legacy rag_system_core-specific variables.
#
# Constructor arguments still take highest priority at runtime.

# ------------------------------------------------------------
# Common / auth
# ------------------------------------------------------------
# Default mode: token string itself is used as user scope.
# Set to 'keycloak' only when docmesh_py_core and Keycloak settings are available.
DOCMESH_AUTH_MODE=token

# Optional common docmesh setting
DOCMESH_ENV=development
DOCMESH_HEALTHCHECK_ENABLED=true

# ------------------------------------------------------------
# docmesh-py-core style service settings
# ------------------------------------------------------------
# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_GENERATION_MODEL=gpt-oss:20b
OLLAMA_REQUEST_TIMEOUT_SECONDS=30

# Milvus
MILVUS_URI=./data/metadata.milvus.db
MILVUS_COLLECTION=rag_chunks
MILVUS_REQUEST_TIMEOUT_SECONDS=30

# Keycloak (required only when DOCMESH_AUTH_MODE=keycloak)
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=docmesh
# KEYCLOAK_CLIENT_ID=rag-system-core
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_VERIFY_SSL=true
# KEYCLOAK_REQUEST_TIMEOUT_SECONDS=10

# ------------------------------------------------------------
# Legacy rag_system_core-specific settings
# ------------------------------------------------------------
# Ollama embedding client
OLLAMA_EMBED__BASE_URL=http://ollama:11434
OLLAMA_EMBED__MODEL=bge-m3
OLLAMA_EMBED__TIMEOUT=30

# Ollama generation client
# If you use the built-in generation client without docmesh_py_core service factory,
# API key/auth-compatible endpoint settings may still be required.
OLLAMA_GENERATE__BASE_URL=https://ollama.com
OLLAMA_GENERATE__MODEL=gpt-oss:20b
OLLAMA_GENERATE__TIMEOUT=30
OLLAMA_GENERATE__API_KEY=

# Milvus settings
MILVUS__URI=./data/metadata.milvus.db
MILVUS__COLLECTION_NAME=rag_chunks
MILVUS__TIMEOUT=30

# ------------------------------------------------------------
# Local persistence examples
# ------------------------------------------------------------
# metadata_path example: ./data/metadata.db
# document_storage_dir example: ./data/documents
